#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CP=""
MP=""
for j in "$ROOT"/lib/*.jar; do
  case "$j" in
    *javafx*)
      MP="${MP:+$MP:}$j"
      ;;
    *)
      CP="${CP:+$CP:}$j"
      ;;
  esac
done
exec java \
  --enable-native-access=javafx.graphics \
  --module-path "$MP" \
  --add-modules javafx.controls,javafx.graphics \
  -cp "$CP" \
  com.pdftoolkit.PdfToolkitApp \
  "$@"
